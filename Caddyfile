# {$DOMAIN} es el dominio de .env. Caddy obtiene y renueva el certificado
# HTTPS solo, siempre que el dominio apunte ya a este servidor y los
# puertos 80 y 443 estén abiertos.
{$DOMAIN} {
	encode zstd gzip

	# La subida más grande es la restauración de una exportación JSON, que la
	# aplicación limita a 20 MB; el margen cubre la codificación multipart.
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8000
}
