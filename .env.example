# Copia este archivo a .env en el servidor y rellénalo. No lo subas a Git.

# Dominio público (debe apuntar ya a la IP del servidor).
# Para probar en tu ordenador: DOMAIN=localhost
DOMAIN=fitness.ejemplo.com

# Clave para firmar los tokens. Mínimo 32 bytes. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FITNESS_TRACKER_JWT_SECRET=

# Conexión a la base de datos PostgreSQL de Supabase (Connect > Session pooler,
# puerto 5432, si el servidor no tiene IPv6; si lo tiene, la conexión directa).
# Sustituye [PASSWORD] y la región. Si la contraseña tiene caracteres especiales,
# codifícalos (por ejemplo @ -> %40).
FITNESS_TRACKER_DATABASE_URL=postgresql://postgres.PROYECTO:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# invite = registro solo con código de invitación (usar siempre en producción).
FITNESS_TRACKER_REGISTRATION_MODE=invite
