# Copia este archivo a .env en el servidor y rellénalo. No lo subas a Git.

# Dominio público (debe apuntar ya a la IP del servidor).
# Para probar en tu ordenador: DOMAIN=localhost
DOMAIN=fitness.ejemplo.com

# Clave para firmar los tokens. Mínimo 32 bytes. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FITNESS_TRACKER_JWT_SECRET=

# Emails con permisos de administrador (copias y restauraciones), separados por comas.
FITNESS_TRACKER_ADMIN_EMAILS=tu_email@ejemplo.com

# invite = registro solo con código de invitación (usar siempre en producción).
FITNESS_TRACKER_REGISTRATION_MODE=invite
